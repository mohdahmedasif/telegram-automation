# --- Relay control hub ---
RELAY_HOST=127.0.0.1
RELAY_PORT=8765
# RELAY_RELOAD=true

# Shared secrets (optional — any automation may reuse these)
GEMINI_API_KEY=your-gemini-api-key
CREDENTIALS_PATH=credentials.json

# --- Pantry Inventory (own bot + own sheet) ---
PANTRY_TELEGRAM_BOT_TOKEN=your-pantry-bot-token
PANTRY_SPREADSHEET_ID=your-pantry-spreadsheet-id
# Optional overrides (fall back to shared values above if unset):
# PANTRY_GEMINI_API_KEY=
# PANTRY_CREDENTIALS_PATH=

# --- Example: next automation would look like this ---
# SHOPPING_TELEGRAM_BOT_TOKEN=your-shopping-bot-token
# SHOPPING_SPREADSHEET_ID=your-shopping-spreadsheet-id
