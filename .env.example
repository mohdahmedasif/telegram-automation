# --- Relay control hub ---
RELAY_HOST=127.0.0.1
RELAY_PORT=8765
# RELAY_RELOAD=true

# Shared secrets (optional — any automation may reuse these)
GEMINI_API_KEY=your-gemini-api-key
# Optional model override (default: gemini-flash-latest). Overloaded models auto-fallback.
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.7-flash,gemini-3-flash-preview
CREDENTIALS_PATH=credentials.json

# --- Household Inventory (pantry + medicine/supplements, one shared sheet) ---
INVENTORY_TELEGRAM_BOT_TOKEN=your-inventory-bot-token
INVENTORY_SPREADSHEET_ID=your-inventory-spreadsheet-id
# Optional tab inside that spreadsheet (from URL ...#gid=...):
# INVENTORY_WORKSHEET_GID=
# Or tab title instead of gid:
# INVENTORY_WORKSHEET=
# Restrict the bot to specific Telegram accounts (comma-separated numeric user
# ids — get yours from @userinfobot). Without this, anyone who finds the bot
# can use it.
# INVENTORY_ALLOWED_USER_IDS=123456789,987654321
# Optional overrides:
# INVENTORY_GEMINI_API_KEY=
# INVENTORY_CREDENTIALS_PATH=
