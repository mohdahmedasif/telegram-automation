# --- Relay control hub ---
RELAY_HOST=127.0.0.1
RELAY_PORT=8765
# RELAY_RELOAD=true

# Shared secrets (optional — any automation may reuse these)
GEMINI_API_KEY=your-gemini-api-key
CREDENTIALS_PATH=credentials.json

# --- Pantry Inventory ---
PANTRY_TELEGRAM_BOT_TOKEN=your-pantry-bot-token
PANTRY_SPREADSHEET_ID=your-pantry-spreadsheet-id
# Optional tab inside that spreadsheet (from URL ...#gid=...):
# PANTRY_WORKSHEET_GID=
# Or tab title instead of gid:
# PANTRY_WORKSHEET=
# Optional overrides:
# PANTRY_GEMINI_API_KEY=
# PANTRY_CREDENTIALS_PATH=

# --- Medicine Inventory ---
MEDICINE_TELEGRAM_BOT_TOKEN=your-medicine-bot-token
MEDICINE_SPREADSHEET_ID=your-medicine-spreadsheet-id
# Optional tab inside that spreadsheet (from URL ...#gid=...):
# MEDICINE_WORKSHEET_GID=
# MEDICINE_WORKSHEET=
# Optional overrides:
# MEDICINE_GEMINI_API_KEY=
# MEDICINE_CREDENTIALS_PATH=
